{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2024",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "sourceMap": true,
    // "emitDecoratorMetadata": true,
    // "experimentalDecorators": true,
    // "useDefineForClassFields": false,
    "paths": {
      "src/*": [
        "./src/*"
      ],
    }
  },
  "include": [
    "src"
  ],
  "files": [
    "src/resource.d.ts"
  ]
}